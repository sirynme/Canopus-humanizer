# ==============================================================================
# TURNITOUT SYSTEM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Port
PORT=8501
API_PORT=8000
ENVIRONMENT=production

# API Security
TURNITOUT_API_KEY=tot_live_demo_local_key
AUTH_REQUIRED=false

# Stage 1: Voice Transformation (Active <-> Passive)
TURNITOUT_VOICE_TRANSFORM=true
TURNITOUT_VOICE_RATE=0.30

# Stage 2: Sentence Fusion (Anti-Burstiness Engine)
TURNITOUT_SENTENCE_FUSION=true
TURNITOUT_FUSION_RATE=0.25

# Stage 3: Transition Phrase Injection (Entropy & Perplexity)
TURNITOUT_TRANSITION_INJECT=true
TURNITOUT_TRANSITION_RATE=0.25

# Stage 4: Clause Word Reordering (Positional Hash Destroyer)
TURNITOUT_WORD_REORDER=true
TURNITOUT_REORDER_RATE=0.20

# Stage 5: Nominalization (Verb <-> Noun Structural Mutation)
TURNITOUT_NOMINALIZATION=true
TURNITOUT_NOMINAL_RATE=0.20

# Stage 6: Appositive Injection (Technical Definition Entropy Bomb)
TURNITOUT_APPOSITIVE=true
TURNITOUT_APPOSITIVE_RATE=0.35

# Stage 7: Discourse Marker Rotation (Anti-Repetition Shield)
TURNITOUT_DISCOURSE_ROTATE=true
TURNITOUT_DISCOURSE_RATE=0.50
